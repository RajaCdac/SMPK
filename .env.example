# Copy to .env and edit for each machine / environment
# cp .env.example .env

# --- MySQL (Docker service name "mysql" when using docker compose) ---
MYSQL_DATABASE=smpk_pension
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- Finance archive (Oracle dump, read-only history) ---
# FINANCE_MYSQL_DATABASE=finance
# FINANCE_MYSQL_HOST=localhost
# FINANCE_MYSQL_PORT=3307
# FINANCE_MYSQL_USER=root
# FINANCE_MYSQL_PASSWORD=root123

# --- Django ---
DJANGO_SECRET_KEY=django-insecure-g8#5k_t-3-o21#+am8nflt%q6sy&uvo)t#0%qe*p-5cht1qgv8
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
ORACLE_LOCAL_CACHE_ENABLED=true
ORACLE_SYNC_REQUIRED=false

# --- Oracle (MySQL-only Docker: leave OFF) ---
# Default deployment uses MySQL data only and never connects to Oracle.
ORACLE_READ_ENABLED=False
INSTALL_ORACLE_CLIENT=false

# To ENABLE live Oracle reads instead:
#   1) set INSTALL_ORACLE_CLIENT=true  (rebuild: docker compose build backend)
#   2) set ORACLE_READ_ENABLED=true
#   3) set ORACLE_CLIENT_LIB=/opt/oracle/instantclient
#   4) fill the ORACLE_DB_* values below
# ORACLE_CLIENT_LIB=/opt/oracle/instantclient
# ORACLE_DB_HOST=host.docker.internal
# ORACLE_DB_PORT=1521
# ORACLE_DB_SERVICE_NAME=kopttestfin
# ORACLE_DB_USER=system
# ORACLE_DB_PASSWORD=system

# --- Frontend build (use /api/ when nginx proxies to backend) ---
VITE_API_BASE_URL=/api/
